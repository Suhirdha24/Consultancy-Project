PORT=5000

# Local MongoDB Connection:
# MONGO_URI=mongodb://127.0.0.1:27017/grocery_db

# Personal MongoDB Atlas Connection (Replace <username>, <password>, and cluster domain):
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/grocery_db?retryWrites=true&w=majority

JWT_SECRET=grocery_secret_key_jwt_token_production_2026
NODE_ENV=development
